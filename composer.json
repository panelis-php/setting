{
  "name": "panelis-php/setting",
  "description": "Manage application settings including general configuration, logging, mail, formatting, and system options",
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "keywords": [
    "panelis"
  ],
  "license": "MIT",
  "require": {
    "bezhansalleh/filament-language-switch": "^4.0",
    "lorisleiva/laravel-actions": "^2.10",
    "filament/filament": "^5.0",
    "panelis-php/user": "^1.2",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Setting\\": "src/",
      "Panelis\\Setting\\Database\\Factories\\": "database/factories/",
      "Panelis\\Setting\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Setting\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Setting\\Providers\\SettingServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Setting\\Plugins\\SettingPlugin"
      ],
      "permissions": {
        "setting": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\SettingPermission",
        "panel": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\PanelPermission",
        "user": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\UserPermission",
        "custom": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\CustomSettingPermission",
        "datetime": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\DatetimePermission",
        "number": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\NumberPermission",
        "mail": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\MailPermission",
        "cache": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\CachePermission",
        "log": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\LogPermission",
        "theme": "Panelis\\Setting\\Panel\\Clusters\\Settings\\Enums\\ThemePermission"
      }
    }
  },
  "require-dev": {
    "laravel/pint": "^1.29"
  }
}
